"Announce progress percentages at 25, 50, 75, and 100 percent during long "
"operations such as downloads and builds. Gives progress feedback while "
"streaming output is suppressed."
msgstr ""

#: addon\lib\settings_panel.py:454
msgid "Earcon &volume (percent):"
msgstr "Sesli ipucu seviyesi (yüzde):"

