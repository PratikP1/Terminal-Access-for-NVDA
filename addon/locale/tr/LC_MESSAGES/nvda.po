msgid "Output &activity tones"
msgstr "Çıktı &etkinliği tonları"

#: addon\lib\settings_panel.py:399
msgid ""
"Play two ascending tones when new program output appears on screen. Does not "
"play for characters you type."
msgstr ""

#: addon\lib\settings_panel.py:406
msgid "Activity tone &debounce (ms):"
msgstr "Etkinlik tonu &gecikmesi (ms):"

# Tooltip for coalesce delay
#: addon\lib\settings_panel.py:414
msgid ""
"Milliseconds between activity tone repeats. Higher values mean fewer tones "
"during sustained output."
msgstr ""
"Birikmiş yeni çıktıyı duyurmadan önce beklenecek milisaniye sayısı. Daha "
"büyük değerler, hızlı çıktı sırasında kesintileri azaltır."

