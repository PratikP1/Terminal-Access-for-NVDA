#. Translators: First step of the first-run tutorial, a welcome line.
#: addon\lib\tutorial.py:8
msgid ""
"Welcome to Terminal Access. Here is a quick tour of the essential commands."
msgstr ""

#. Translators: Tutorial step explaining how to enter the command layer.
#: addon\lib\tutorial.py:10
msgid ""
"Press NVDA+apostrophe to enter the command layer, where single keys run "
"Terminal Access commands."
msgstr ""

#. Translators: Tutorial step explaining line navigation in the command layer.
#: addon\lib\tutorial.py:12
msgid ""
"In the command layer, press U, I and O to read the previous, current and "
"next line."
msgstr ""

#. Translators: Tutorial step explaining the output search command.
#: addon\lib\tutorial.py:14
msgid "Press NVDA+F to search the terminal output."
msgstr "Terminal çıktısında arama yapmak için NVDA+F tuşlarına basın."

#. Translators: Tutorial step explaining the bookmark list command.
#: addon\lib\tutorial.py:16
msgid "In the command layer, press B to list your bookmarks."
msgstr "Komut katmanındayken, yer imlerinizi listelemek için B'ye basın."

#. Translators: Tutorial step explaining how to open the user guide.
#: addon\lib\tutorial.py:18
msgid "Press NVDA+Shift+F1 to open the full user guide."
msgstr "Tam kullanım kılavuzunu açmak için NVDA+Shift+F1 tuşlarına basın."

#. Translators: Closing step of the tutorial, explaining how to replay it.
#: addon\lib\tutorial.py:20
msgid ""
"To hear this tutorial again, press NVDA+apostrophe and then Shift+H at any "
"time."
msgstr ""

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Terminal Access for NVDA"
msgstr "NVDA için Terminal Erişimi"

# Long description to be shown for this add-on on add-on information from add-
# ons manager
#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid ""
"Provides enhanced terminal accessibility for Windows Terminal and "
"PowerShell, enabling screen reader users to efficiently navigate and "
"interact with command-line interfaces. Inspired by TDSR (Terminal Data "
"Structure Reader) and incorporates functionality from both TDSR and Speakup. "
"Advanced features inspired by community suggestions and discussions."
msgstr ""
"Windows Terminal ve PowerShell için gelişmiş terminal erişilebilirliği "
"sağlayarak, ekran okuyucu kullanıcılarının komut satırı arayüzlerinde "
"verimli bir şekilde gezinmelerini ve etkileşim kurmalarını sağlar. TDSR "
"(Terminal Data Structure Reader) tarafından ilham alınarak geliştirilmiş "
"olup, hem TDSR hem de Speakup'ın işlevselliğini bünyesinde barındırır. "
"Topluluk önerileri ve tartışmalarından ilham alan gelişmiş özellikler."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid ""
"v2.0.1: fixes the 2.0.0 package missing the user guide (NVDA+Shift+F1 did "
"nothing) and all translations. Install this over 2.0.0. Everything else is "
"2.0.0: AI CLI support, semantic navigation, table mode, faster and more "
"reliable search, and a pure Python add-on with ARM64 support."
msgstr ""

