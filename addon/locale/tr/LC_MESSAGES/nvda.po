"Play a low tone on error lines and a higher tone on warning lines during "
"navigation."
msgstr ""

#: addon\lib\settings_panel.py:382
msgid "Error audio cues in &quiet mode"
msgstr "&Sessiz modda hata sesli ipuçları"

#: addon\lib\settings_panel.py:387
