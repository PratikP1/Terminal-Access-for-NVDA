msgstr "Terminal Erişimi sesli ipuçlarının yüksekliği, yüzde 10 ile 100 arası."

#: addon\lib\settings_panel.py:468
msgid "Earcon &pitch (percent):"
msgstr "Sesli ipucu &tonu (yüzde):"

#: addon\lib\settings_panel.py:476
msgid ""
"Shift all audio cue frequencies, from 50 to 200 percent. Lower values help "
"with high-frequency hearing loss, higher values help with low-frequency "
"hearing loss."
msgstr ""

#: addon\lib\settings_panel.py:491
msgid ""
"These features process terminal text locally on your machine.\n"
"No data is sent to any server. Enable only the ones you need."
msgstr ""

#: addon\lib\settings_panel.py:499
msgid "Enable &summarization"
msgstr "&Özetlemeyi etkinleştir"

#: addon\lib\settings_panel.py:504
msgid ""
"Allow offline extractive summarization of terminal output. Use NVDA+' then Z "
"to summarize recent output."
msgstr ""

#: addon\lib\settings_panel.py:511
msgid "Enable code block e&xplanation"
msgstr "Kod bloğu a&çıklamasını etkinleştir"

#: addon\lib\settings_panel.py:516
msgid ""
"Allow offline heuristic explanation of fenced code blocks. Assign a gesture "
"to the explain command in NVDA's Input Gestures dialog."
msgstr ""

#: addon\lib\settings_panel.py:523
msgid "Enable &AI conversation parsing"
msgstr "&Yapay zeka görüşme ayrıştırmasını etkinleştir"

#: addon\lib\settings_panel.py:528
