msgstr "İmleç gecikmesi (milisaniye):"

# Tooltip for cursor delay
#: addon\lib\settings_panel.py:264
msgid ""
"Delay before announcing cursor position (0-1000ms). Higher values reduce "
"announcement frequency."
msgstr ""
"İmleç konumunu duyurmadan önce gecikme (0-1000 ms). Daha yüksek değerler "
"duyuru sıklığını azaltır."

#: addon\lib\settings_panel.py:271
msgid "Pause at &newlines"
msgstr "&newlines'da duraklat"

# Tooltip for line pause
#: addon\lib\settings_panel.py:276
